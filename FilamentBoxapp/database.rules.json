{
  "rules": {
    ".read": false,
    ".write": false,
    "filamentBox": {
      "miembros": {
        "$uid": {
          ".read": "auth != null && auth.uid == $uid",
          ".write": false
        }
      },
      "dispositivos": {
        ".read": false,
        ".write": false
      },
      "control": {
        ".read": "(auth != null && root.child('filamentBox/miembros').child(auth.uid).val() == true) || (auth != null && root.child('filamentBox/dispositivos').child(auth.uid).val() == true)",
        ".write": "(auth != null && root.child('filamentBox/miembros').child(auth.uid).val() == true) && newData.exists()",
        ".validate": "newData.hasChildren(['power','auto','fan','inletOpen','outletExterior','mode','settings','issuedAt'])",
        "power": {
          ".validate": "newData.isBoolean()"
        },
        "auto": {
          ".validate": "newData.isBoolean()"
        },
        "fan": {
          ".validate": "newData.isBoolean()"
        },
        "inletOpen": {
          ".validate": "newData.isBoolean()"
        },
        "outletExterior": {
          ".validate": "newData.isBoolean()"
        },
        "mode": {
          ".validate": "newData.isString() && (newData.val() == 'OFF' || newData.val() == 'AUTO' || newData.val() == 'STORAGE' || newData.val() == 'RECIRC' || newData.val() == 'PURGE' || newData.val() == 'MAINT')"
        },
        "issuedAt": {
          ".validate": "newData.isNumber() && newData.val() > now - 30000 && newData.val() <= now + 5000"
        },
        "settings": {
          ".validate": "newData.hasChildren(['targetRh','hysteresis','uvAlert'])",
          "targetRh": {
            ".validate": "newData.isNumber() && newData.val() >= 10 && newData.val() <= 60"
          },
          "hysteresis": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 20"
          },
          "uvAlert": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 11"
          },
          "$other": {
            ".validate": false
          }
        },
        "$other": {
          ".validate": false
        }
      },
      "sensores": {
        ".validate": "newData.hasChildren(['sampleId','sampleTs','sampleUptimeMs','chamber','outdoor','postSilica','uv','uvUnit'])",
        "chamber": {
          ".validate": "newData.hasChild('valid') && (newData.child('valid').val() == false || newData.hasChildren(['t','rh']))",
          "valid": {
            ".validate": "newData.isBoolean()"
          },
          "t": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 50"
          },
          "rh": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
          },
          "$other": {
            ".validate": false
          }
        },
